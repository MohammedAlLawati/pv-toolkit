# Copy to .env and fill in.  Never commit .env.

# Your site's address (a domain or subdomain you control, pointed at the server)
DOMAIN=pv.example.com

# Long random string. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

APP_NAME=PV Toolkit
SESSION_HOURS=12
COOKIE_SECURE=1

# Datasheet reading with Claude (recommended). Create a key at https://console.anthropic.com
# (Settings -> API keys). Each datasheet costs roughly a few cents to read.
ANTHROPIC_API_KEY=
# Model used to read datasheets (claude-sonnet-5-5 is accurate and inexpensive)
ANTHROPIC_MODEL=claude-sonnet-5-5
